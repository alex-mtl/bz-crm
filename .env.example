APP_NAME="BZ-CRM-Social"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Host ports (docker-compose)
APP_PORT=8100
FORWARD_DB_PORT=3316
MAILPIT_UI_PORT=8126
VITE_PORT=5174

LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bz_crm
DB_USERNAME=bz_crm
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time of the messenger (ADR-012): "reverb" with the reverb container running, "log" without it.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the application publishes (inside the Docker network) ...
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# ... and where browsers connect.
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8180
REVERB_CLIENT_SCHEME=http

# Antivirus check of uploaded files (ADR-012): "none" or "clamav" (needs the clamav container:
# docker compose --profile antivirus up -d clamav). In production — "clamav".
ATTACHMENT_SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=bz_crm_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bz-crm.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local-only seed account for the Filament admin panel (never used outside local/testing).
SEED_ADMIN_EMAIL=admin@bz-crm.test
SEED_ADMIN_PASSWORD=password

# ФО §6.1 applicant landing page link (placeholder until the real domain is known)
PARTY_SITE_URL=https://bz.ttl10.net

# Demo world (Д-2, Д-5): shared password of demo personas and the demo TOTP secret (base32). Never used in production.
DEMO_USER_PASSWORD=

# Д-18: declarative "retain until" for confidential layers; nothing is deleted by it yet
RETENTION_DEFAULT_UNTIL=2030-01-01
DEMO_TOTP_SECRET=
